#!/usr/bin/env bash

# Ensure script is run as root

ID=$(id -u -n)
if [ "$ID" != "root" ]; then
    sudo "$0" "$@"
    exit
fi

# Only use the core os versions of commands
    
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# Ensure the required version of python exists

PYTHON=$(which python3.12)

if [ ! -x "$PYTHON" ]; then
    echo "Could not find python executable" >&2
    exit 1
fi

SCRIPT="$(realpath $0)"
UTILS=`dirname "$SCRIPT"`
ROOT=`dirname "$UTILS"`
VENV_LINK="$ROOT/venv"
VENV_TARGET="/usr/local/venvs/fairdata-sso"

# Remove old venv if it exists
rm -fr "$VENV_TARGET" 2>/dev/null
rm -f "$VENV_LINK" 2>/dev/null

# Create parent directory if it doesn't exist
mkdir -p /usr/local/venvs

# Create new venv
$PYTHON -m venv "$VENV_TARGET"

# Create symlink and set ownership to sso:sso
ln -s "$VENV_TARGET" "$VENV_LINK"

source "$VENV_LINK/bin/activate"
pip install --upgrade pip
pip install -r $ROOT/requirements.txt

chown -h sso:sso "$VENV_LINK"
chown -R sso:sso "$VENV_TARGET"


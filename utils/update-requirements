#!/usr/bin/env bash
#--------------------------------------------------------------------------------
# Ensure script is run as root

ID=$(id -u -n)
if [ "$ID" != "root" ]; then
    sudo "$0" "$@"
    exit
fi

# Only use the core os versions of commands + pipx/poetry local bin

PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin"
export PATH

#--------------------------------------------------------------------------------

function portable_realpath() {
    if [[ "$OSTYPE" = "darwin"* ]]; then
        [[ $1 = /* ]] && echo "$1" || echo "$(cd "$(dirname "$1")"; pwd)/$(basename "$1")"
    else
        realpath "$1"
    fi
}

SCRIPT_ROOT=`dirname "$(portable_realpath $0)"`
VENV_ROOT=`dirname "$SCRIPT_ROOT"`

cd $VENV_ROOT

source $VENV_ROOT/venv/bin/activate

poetry export -f requirements.txt --output requirements.txt --without-hashes

